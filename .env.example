# Live-capital defaults are intentionally zero.
MAX_CAPITAL_USD=0
MAX_NOTIONAL_USD=0
MAX_DAILY_LOSS_USD=0
MAX_DAILY_FEES_USD=0
MAX_LEVERAGE=1
MAX_OPEN_POSITIONS=0
MAX_API_ERRORS=3
MAX_DATA_AGE_SECONDS=120
SIMULATED_NOTIONAL_USD=100

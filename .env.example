# LIVE remains disabled in this v1 build even if these are changed.
LIVE_APPROVED=false
TARGET_LIVE_APPROVED=false
LEGAL_STATUS=REVIEW_REQUIRED
TERMS_STATUS=REVIEW_REQUIRED
PROGRAM_STATUS=UNKNOWN
API_REWARD_ELIGIBLE=false
